common.hxml

#--library hxcpp-debug-server
#-D debug

-D PLATFORM_DESKTOP
-D HXCPP_M64

-lib hxcpp-debug-server
#--debug # we will let the user provide the --debug flag on the command line when they want debug builds

# Colon-separated source roots for CPPIA source resolution in hxcpp 4.x debugger.
# Relative paths are resolved from the executable directory ($ORIGIN). Optional
# runtime env HXCPP_CPPIA_SOURCE_ROOTS is merged additively (same syntax).
-D HXCPP_CPPIA_SOURCE_ROOTS=../../../../examples/www/public/assets/scripts/haxe:../../src:../../../../bindings/haxe

-cpp out/desktop
