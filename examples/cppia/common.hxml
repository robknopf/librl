-cp src
-cp ../../..
-cp ../../bindings/haxe

-D scriptable

-lib hxasync


# Set the LIBRL_ROOT environment variable to the path to the librl root directory
# Note that this is a relative path to the output directory.
-D LIBRL_ROOT=../../../..
-D WGUTILS_ROOT=../../../../deps/wgutils
#-D analyzer-optimize
#-D no-traces
#--dce full

#--dce no

--macro macros.ExportCABI.apply()

# hxcpp-debugger needs these for cppia script debugging
--macro include('haxe.NativeStackTrace', true)
--macro include('haxe.CallStack', true)
--macro keep('haxe.NativeStackTrace')
--macro keep('haxe.CallStack')

# list of classes that may not be in the ScriptableMain class, but we want to make available to scripts
# otherwise, they will load them into the scripts themselves
--macro include('rl', true)
--macro include('utils', true)


# dce strips unused code from the host, making scripts unable to use them
# keep will ensure that dce doesn't strip them
# see https://api.haxe.org/haxe/macro/Compiler.html#include
--macro keep('StringTools')
--macro keep('rl')
--macro keep('utils')



--main ScriptableMain
