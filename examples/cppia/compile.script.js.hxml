# usage:  haxe compile.script.js.hxml <script class>
# example: haxe compile.script.js.hxml MainScript

#--run tools.CompileScript

--cmd rm -rf ../www/public/assets/scripts/haxe/js
--next

# Set the LIBRL_ROOT environment variable to the path to the librl root directory
# Note that this is a relative path to the output directory.
-D LIBRL_ROOT=../../../..
-D WGUTILS_ROOT=../../../../deps/wgutils
#-D analyzer-optimize
#-D no-traces
#--dce full

-lib hxasync
-lib genes

-cp ../../bindings/haxe
-cp src
-cp ../www/public/assets/scripts/haxe
#--dce no

#--macro macros.RuntimeCAbiMacro.registerGlobal()
# ensure that rl.RL is available to scripts, in case the host didn't import them
#--macro include('rl', true)
#--macro include('haxe.NativeStackTrace', true)
#--macro include('haxe.CallStack', true)

# dce will strip unused code from the host, making scripts unable to use them
# keep will ensure that dce doesn't strip them
# see https://api.haxe.org/haxe/macro/Compiler.html#include

#--macro keep('StringTools')
#--macro keep('rl')
#--macro keep('haxe.NativeStackTrace')
#--macro keep('haxe.CallStack')

#--main ScriptableMain

--macro exclude('rl.impl.RLImpl')

-js ../www/public/assets/scripts/haxe/js/Main.js

#-D source-map-content
-D debug
-D source-map
-D js-es=6

# to fix sourcemap generation after hxasync changes the output, we
# take a snapshot before.
#--macro macros.MakeESM.capturePreAsyncOutput()
#--macro hxasync.AsyncMacro.makeAsyncable("")
#--macro macros.MakeESM.apply()

#--times

#--next
#--macro macros.SuppressViteImportWarning.apply("out/js/main.js")

MainScript

--cmd echo "Build (js) complete."
