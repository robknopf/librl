common.hxml

# --cmd mkdir -p ../www/public/assets/scripts/haxe

-js ../www/public/assets/scripts/haxe/main.js

#-D source-map-content
-D source-map
-D js-es=6

# to fix sourcemap generation after hxasync changes the output, we
# take a snapshot before.
--macro macros.MakeESM.capturePreAsyncOutput()
--macro hxasync.AsyncMacro.makeAsyncable("")
--macro macros.MakeESM.apply()

#--times

#--next
#--macro macros.SuppressViteImportWarning.apply("../www/public/assets/scripts/haxe/main.js")

--cmd echo "Build (js) complete."
