# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# When RL_REMOTE_ENABLE_TLS=1, cert.pem and privkey.pem must exist under KEYS_DIR.
# TLS applies to the whole listener (https static files + wss on /ws).

KEYS_DIR=/path/to/certs
RL_REMOTE_PUBLIC_ROOT="../www/public"
RL_REMOTE_HTTP_ROOT="../www"
RL_REMOTE_WATCH_DEBOUNCE_MS=150
RL_REMOTE_ENABLE_TLS=1
RL_REMOTE_PORT=9001

# Extra URL mounts: /prefix=path; /prefix2=path2 (semicolon-separated, paths relative to cwd).
# librl testbed (run from examples/script_watcher/):
RL_REMOTE_HTTP_MOUNTS=/examples=..;/bindings=../../bindings;/lib=../../lib
