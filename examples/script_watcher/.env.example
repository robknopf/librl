# Copy to .env and adjust for your machine:
#   cp .env.example .env
#
# TLS: cert.pem and privkey.pem must exist under KEYS_DIR when RL_REMOTE_WS_PROTOCOL=wss.

KEYS_DIR=/path/to/certs
RL_REMOTE_PUBLIC_ROOT="../www/public"
RL_REMOTE_WATCH_DEBOUNCE_MS=150
RL_REMOTE_WS_PROTOCOL=wss
RL_REMOTE_WS_PORT=9001
